{
  "name": "ghanaverse",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate && pnpm db:migrate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:validate": "prisma validate",
    "db:migrate:reset": "tsx scripts/database.ts reset && prisma migrate deploy && prisma db seed",
    "db:seed": "prisma db seed",
    "content:import:ghmdb": "tsx scripts/import-ghmoviesdb.ts",
    "check": "pnpm db:validate && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "db:backup": "tsx scripts/database.ts backup",
    "db:reset:verified": "tsx scripts/database.ts reset",
    "test:prepare": "tsx scripts/test-database.ts",
    "qa:browser": "tsx scripts/browser-qa.ts",
    "qa:viewer": "tsx scripts/viewer-qa.ts",
    "qa:rights": "tsx scripts/rights-playback-qa.ts",
    "video:storage:check": "node --conditions=react-server --import tsx scripts/video-storage.ts check",
    "video:storage:status": "node --conditions=react-server --import tsx scripts/video-storage.ts status",
    "video:storage:cleanup": "node --conditions=react-server --import tsx scripts/video-storage.ts cleanup",
    "qa:video": "tsx scripts/video-browser-qa.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@better-auth/prisma-adapter": "^1.7.4",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "better-auth": "^1.7.4",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.45.0",
    "mp4box": "^2.4.1",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.1.3",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@11.11.0"
}
