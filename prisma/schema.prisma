generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VIEWER
  RIGHTS_HOLDER
  ADMIN
}

enum ContentType {
  MOVIE
  SERIES
  DOCUMENTARY
  CULTURAL_PROGRAMME
  LIFESTYLE_PROGRAMME
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum MetadataSource {
  MANUAL
  GH_MOVIES_DB
  YOUTUBE
  OTHER
}

enum MediaRights {
  ORIGINAL
  LICENSED
  CREATIVE_COMMONS
  PUBLIC_DOMAIN
  DEMO
  UNKNOWN
}

enum CreditType {
  CAST
  DIRECTOR
  WRITER
  PRODUCER
  CREATOR
}

enum VideoSourceType {
  MANAGED
  REMOTE_URL
  YOUTUBE
  DEMO
}

model User {
  id                      String                   @id
  name                    String
  email                   String                   @unique
  isSuspended             Boolean                  @default(false)
  emailVerified           Boolean                  @default(false)
  image                   String?
  role                    UserRole                 @default(VIEWER)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                Session[]
  accounts                Account[]
  profiles                ViewerProfile[]
  rightsHolderMemberships RightsHolderMembership[]
  playbackSessions        PlaybackSession[]
  payments                BillingPayment[]
  premiumGrants           PremiumGrant[]
}

model ViewerProfile {
  id                  String            @id @default(cuid())
  userId              String
  name                String
  avatar              String?
  image               String?
  isKids              Boolean           @default(false)
  autoplayNextEpisode Boolean           @default(false)
  preferSubtitles     Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlist           WatchlistItem[]
  progress            WatchProgress[]
  playbackSessions    PlaybackSession[]

  @@index([userId])
}

model Content {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  title                String
  shortDescription     String
  description          String
  tagline              String?
  releaseYear          Int?
  releaseDate          DateTime?
  country              String?
  seriesStatus         String?
  contentType          ContentType
  runtimeMinutes       Int?
  classification       String?
  classificationRecord Classification?    @relation(fields: [classification], references: [name], onDelete: Restrict, onUpdate: Cascade)
  publicationStatus    PublicationStatus  @default(DRAFT)
  isFeatured           Boolean            @default(false)
  isPremium            Boolean            @default(false)
  posterUrl            String?
  backdropUrl          String?
  metadataSource       MetadataSource     @default(MANUAL)
  sourceReferenceUrl   String?
  externalId           String?
  tmdbId               Int?
  imdbId               String?
  sourceRating         Float?
  sourcePayload        Json?
  externalWatchLinks   Json?
  mediaRights          MediaRights        @default(UNKNOWN)
  attributionNotes     String?
  productionCompanyId  String?
  rightsHolderId       String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  publishedAt          DateTime?
  productionCompany    ProductionCompany? @relation(fields: [productionCompanyId], references: [id], onDelete: SetNull)
  rightsHolder         RightsHolder?      @relation(fields: [rightsHolderId], references: [id], onDelete: SetNull)
  genres               ContentGenre[]
  languages            ContentLanguage[]
  credits              ContentCredit[]
  trailer              Trailer?
  seasons              Season[]
  videoAssets          VideoAsset[]
  watchlist            WatchlistItem[]
  progress             WatchProgress[]
  collectionItems      CollectionItem[]
  playbackSessions     PlaybackSession[]
  licenses             ContentLicense[]

  @@unique([metadataSource, externalId])
  @@index([publicationStatus, contentType])
  @@index([isFeatured, publicationStatus])
}

model Genre {
  id       String         @id @default(cuid())
  name     String         @unique
  slug     String         @unique
  contents ContentGenre[]
}

model Language {
  id       String            @id @default(cuid())
  name     String            @unique
  code     String            @unique
  contents ContentLanguage[]
}

model Classification {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  contents Content[]
}

model ContentGenre {
  contentId String
  genreId   String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  genre     Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([contentId, genreId])
}

model ContentLanguage {
  contentId  String
  languageId String
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([contentId, languageId])
}

model Person {
  id       String          @id @default(cuid())
  name     String          @unique
  imageUrl String?
  credits  ContentCredit[]
}

model ContentCredit {
  contentId     String
  personId      String
  creditType    CreditType
  characterName String?
  content       Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  person        Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([contentId, personId, creditType])
}

model ProductionCompany {
  id       String    @id @default(cuid())
  name     String    @unique
  contents Content[]
}

model RightsHolder {
  id           String                   @id @default(cuid())
  name         String                   @unique
  contactEmail String?
  notes        String?
  phone        String?
  address      String?
  website      String?
  contents     Content[]
  memberships  RightsHolderMembership[]
  licenses     ContentLicense[]
  recipients   PayoutRecipient[]
}

model RightsHolderMembership {
  userId         String
  rightsHolderId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rightsHolder   RightsHolder @relation(fields: [rightsHolderId], references: [id], onDelete: Restrict)

  @@id([userId, rightsHolderId])
  @@index([rightsHolderId])
}

model Trailer {
  id             String  @id @default(cuid())
  contentId      String  @unique
  youtubeVideoId String
  title          String?
  thumbnailUrl   String?
  content        Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model Season {
  id           String    @id @default(cuid())
  seriesId     String
  seasonNumber Int
  title        String?
  description  String?
  series       Content   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes     Episode[]

  @@unique([seriesId, seasonNumber])
}

model Episode {
  id               String            @id @default(cuid())
  seasonId         String
  episodeNumber    Int
  title            String
  description      String?
  runtimeMinutes   Int?
  airDate          DateTime?
  thumbnailUrl     String?
  season           Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  videoAssets      VideoAsset[]
  progress         WatchProgress[]
  playbackSessions PlaybackSession[]

  @@unique([seasonId, episodeNumber])
}

model VideoAsset {
  id               String             @id @default(cuid())
  contentId        String?
  episodeId        String?
  sourceType       VideoSourceType
  playbackUrl      String?
  storedObjectId   String?            @unique
  storedObject     StoredVideoObject? @relation(fields: [storedObjectId], references: [id], onDelete: Restrict)
  durationSeconds  Int?
  licenseType      MediaRights
  isPlayable       Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  content          Content?           @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode          Episode?           @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  playbackSessions PlaybackSession[]
}

model PlaybackSession {
  id                   String           @id @default(cuid())
  idempotencyKey       String           @unique
  userId               String
  profileId            String
  videoAssetId         String
  contentId            String
  episodeId            String?
  startedAt            DateTime         @default(now())
  lastSampleAt         DateTime         @default(now())
  lastSequence         Int              @default(0)
  watchedMilliseconds  Int              @default(0)
  reportedMilliseconds Int              @default(0)
  durationSeconds      Float?
  coverage             Json             @default("[]")
  completedAt          DateTime?
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile              ViewerProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  videoAsset           VideoAsset       @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  content              Content          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode              Episode?         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  samples              PlaybackSample[]

  @@index([contentId, startedAt])
  @@index([userId, startedAt])
  @@index([startedAt])
}

model PlaybackSample {
  sessionId           String
  sequence            Int
  watchedMilliseconds Int
  createdAt           DateTime        @default(now())
  session             PlaybackSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, sequence])
  @@index([createdAt])
}

model WatchlistItem {
  id        String        @id @default(cuid())
  profileId String
  contentId String
  createdAt DateTime      @default(now())
  profile   ViewerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content   Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([profileId, contentId])
}

model WatchProgress {
  id              String        @id @default(cuid())
  profileId       String
  contentId       String?
  episodeId       String?
  positionSeconds Int           @default(0)
  durationSeconds Int?
  completed       Boolean       @default(false)
  lastWatchedAt   DateTime      @default(now())
  profile         ViewerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content         Content?      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  episode         Episode?      @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([profileId, lastWatchedAt])
}

model Collection {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  items       CollectionItem[]
}

model CollectionItem {
  collectionId String
  contentId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  content      Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([collectionId, contentId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model ArtworkAsset {
  id           String   @id @default(cuid())
  publicId     String   @unique
  secureUrl    String   @unique
  purpose      String
  width        Int
  height       Int
  bytes        Int
  uploadedById String
  createdAt    DateTime @default(now())
}

// Provider identifiers are private. Reservations survive failed provider operations.
model VideoUploadSession {
  id                  String                   @id
  idempotencyKey      String                   @unique
  actorId             String
  contentId           String
  episodeId           String?
  destination         String
  filename            String
  fileSize            BigInt
  lastModified        Float
  fingerprint         String
  licenseType         MediaRights
  mediaMetadata       Json
  endpoint            String
  bucket              String
  objectKey           String                   @unique
  processingObjectKey String?
  processingBytes     BigInt?
  sourceDeleted       Boolean                  @default(false)
  providerUploadId    String?
  status              String                   @default("INITIALIZING")
  expiresAt           DateTime
  leaseToken          String?
  leaseUntil          DateTime?
  lastError           String?
  assetId             String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  reservation         VideoStorageReservation?
  parts               VideoUploadPart[]
  storedObject        StoredVideoObject?

  @@index([contentId, status])
  @@index([expiresAt, status])
  @@index([status, leaseUntil, createdAt])
}

model VideoUploadPart {
  sessionId  String
  partNumber Int
  md5        String
  session    VideoUploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, partNumber])
}

model VideoProcessorHeartbeat {
  id     String   @id
  seenAt DateTime
}

model BillingPlan {
  id                  String           @id @default("premium")
  amount              Int              @default(4500)
  currency            String           @default("GHS")
  days                Int              @default(30)
  enabled             Boolean          @default(true)
  commercialConfirmed Boolean          @default(false)
  updatedAt           DateTime         @updatedAt
  payments            BillingPayment[]
}

model BillingPayment {
  id             String        @id @default(cuid())
  reference      String        @unique
  idempotencyKey String
  userId         String
  planId         String
  mode           String
  amount         Int
  currency       String        @default("GHS")
  days           Int           @default(30)
  email          String
  channel        String
  mobileMoneyNetwork String?
  maskedPayerPhone String?
  status         String        @default("PENDING")
  providerId     String?
  checkoutUrl    String?
  fee            Int?
  refundAmount   Int           @default(0)
  reviewRequired Boolean       @default(false)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan           BillingPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  grant          PremiumGrant?

  @@unique([userId, mode, idempotencyKey])
  @@index([userId, mode, createdAt])
  @@index([mode, status])
}

model PremiumGrant {
  id        String         @id @default(cuid())
  paymentId String         @unique
  userId    String
  mode      String
  startsAt  DateTime
  endsAt    DateTime
  revokedAt DateTime?
  payment   BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, mode, endsAt])
}

model ContentLicense {
  id                String          @id @default(cuid())
  contentId         String
  rightsHolderId    String
  startsAt          DateTime
  endsAt            DateTime
  dueAt             DateTime
  amount            Int
  currency          String          @default("GHS")
  contractReference String
  commercialUse     Boolean
  status            String          @default("DRAFT")
  approvedById      String?
  createdAt         DateTime        @default(now())
  content           Content         @relation(fields: [contentId], references: [id], onDelete: Restrict)
  rightsHolder      RightsHolder    @relation(fields: [rightsHolderId], references: [id], onDelete: Restrict)
  payouts           PayoutAttempt[]

  @@index([contentId, status, startsAt, endsAt])
}

model PayoutRecipient {
  id             String          @id @default(cuid())
  rightsHolderId String
  mode           String
  type           String
  name           String
  bankCode       String
  maskedAccount  String
  providerCode   String
  status         String          @default("PENDING")
  approvedById   String?
  createdAt      DateTime        @default(now())
  rightsHolder   RightsHolder    @relation(fields: [rightsHolderId], references: [id], onDelete: Restrict)
  payouts        PayoutAttempt[]

  @@unique([mode, providerCode])
  @@index([rightsHolderId, mode, status])
}

model PayoutAttempt {
  id             String          @id @default(cuid())
  licenseId      String
  recipientId    String
  mode           String
  reference      String          @unique
  amount         Int
  currency       String          @default("GHS")
  recipientCode  String
  recipientLabel String
  status         String          @default("APPROVED")
  approvedById   String
  transferCode   String?
  leaseUntil     DateTime?
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  license        ContentLicense  @relation(fields: [licenseId], references: [id], onDelete: Restrict)
  recipient      PayoutRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([licenseId, mode, status])
}

model PaymentWebhook {
  id          String   @id
  mode        String
  event       String
  resourceId  String
  processedAt DateTime @default(now())
}

model VideoStorageReservation {
  sessionId  String             @id
  bytes      BigInt
  releasedAt DateTime?
  session    VideoUploadSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
}

model StoredVideoObject {
  id        String             @id
  sessionId String             @unique
  endpoint  String
  bucket    String
  objectKey String             @unique
  bytes     BigInt
  etag      String
  state     String             @default("READY")
  metadata  Json
  lastError String?
  createdAt DateTime           @default(now())
  deletedAt DateTime?
  session   VideoUploadSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  asset     VideoAsset?

  @@index([state])
}
