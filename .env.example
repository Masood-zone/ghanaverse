DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
YOUTUBE_API_KEY=

SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=GhanaVerse Administrator
SEED_ADMIN_PASSWORD=
TEST_DATABASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Private R2 video bucket; never add NEXT_PUBLIC_ to these names.
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STORAGE_BUDGET_BYTES=8000000000

# Required on the separate video worker only. Leave blank to use tools on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
VIDEO_PROCESSING_TEMP_DIR=

# Server-only Paystack credentials. Hosted checkout does not require a browser key.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Keep live collection/transfers off until their documented launch checks pass.
BILLING_LIVE_ENABLED=false
PAYOUTS_LIVE_ENABLED=false

# GhanaVerse transactional messages; configure separately from Amanah.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
UELLOSEND_API_KEY=
UELLOSEND_SENDER_ID=GhanaVerse
UELLOSEND_API_URL=https://uellosend.com/quicksend/
NOTIFICATION_TIMEOUT_MS=10000
# Enable only on the dedicated notification worker; no preview drains.
NOTIFICATION_WORKER_ENABLED=false
